# Copie para apps/web/.env quando precisar de configuracao local ou no VPS.
# Na hospedagem Node.js gerenciada da Hostinger, configure as variaveis no hPanel.
# Nao defina PORT nem HOST no hPanel: a plataforma fornece a porta.
NODE_ENV=production

# Para o VPS com Nginx deste repositorio, acrescente HOST=127.0.0.1 e PORT=3000.
POCKETBASE_URL=http://127.0.0.1:8090

# Use os mesmos dados definidos em apps/pocketbase/.env.
# Necessarios somente para rotas que acessam o PocketBase como administrador.
PB_SUPERUSER_EMAIL=
PB_SUPERUSER_PASSWORD=
