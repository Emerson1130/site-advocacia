# Copie para apps/web/.env no desenvolvimento ou no VPS.
# No VPS, mantenha o servidor HTTP acessivel apenas pelo proxy Nginx.
NODE_ENV=production
HOST=127.0.0.1
PORT=3000
POCKETBASE_URL=http://127.0.0.1:8090

# Use os mesmos dados definidos em apps/pocketbase/.env.
# Necessarios somente para rotas que acessam o PocketBase como administrador.
PB_SUPERUSER_EMAIL=
PB_SUPERUSER_PASSWORD=
